# Copy to .env and fill in. Never commit .env.
RUST_LOG=info,failscope=debug

# Postgres (M6)
DATABASE_URL=postgres://failscope:failscope@localhost:5432/failscope

# Solana RPC, used for fixtures (M2) and IDL fetches (M4)
RPC_URL=https://api.devnet.solana.com

# Yellowstone gRPC (M5)
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_X_TOKEN=
