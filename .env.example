# Copy to .env and fill in. Never commit .env.
RUST_LOG=info,failscope=debug

# Postgres (docker compose up -d)
DATABASE_URL=postgres://failscope:failscope@localhost:5432/failscope

# Solana JSON-RPC, used for IDL fetches. Local validator: http://127.0.0.1:8899
RPC_URL=http://127.0.0.1:8899

# Yellowstone gRPC. Local validator with plugin (dev/localnet.sh): http://127.0.0.1:10000
YELLOWSTONE_ENDPOINT=http://127.0.0.1:10000
YELLOWSTONE_X_TOKEN=
# Cursor name; change it to run a second stream against the same database.
INGEST_STREAM=default
# Optional JSON file overriding bot-scoring thresholds/weights (D27), e.g.
# {"high_rate_failures": 30, "weights": {"jito_tip": 25}}
# SCORE_CONFIG=score.json

# Alerts (failscope alert). The webhook URL is a secret.
ALERT_WEBHOOK_URL=
# ALERT_WINDOW_MINUTES=5
# ALERT_BASELINE_MINUTES=60
# ALERT_FACTOR=3
# ALERT_MIN_FAILURES=10
# ALERT_METRIC=failures      # or human-signers: count likely-human wallets instead
# ALERT_PROGRAMS=            # comma-separated; empty = all programs
DASHBOARD_URL=http://127.0.0.1:8080

# docker compose only (see docker-compose.yml). Defaults reach the localnet
# validator on the host; set these for a hosted devnet endpoint.
# COMPOSE_YELLOWSTONE_ENDPOINT=http://host.docker.internal:10000
# COMPOSE_RPC_URL=http://host.docker.internal:8899
