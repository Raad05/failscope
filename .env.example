# Copy to .env and fill in. Never commit .env.
RUST_LOG=info,failscope=debug

# Postgres (docker compose up -d)
DATABASE_URL=postgres://failscope:failscope@localhost:5432/failscope

# Solana JSON-RPC, used for IDL fetches. Local validator: http://127.0.0.1:8899
RPC_URL=http://127.0.0.1:8899

# Yellowstone gRPC. Local validator with plugin (dev/localnet.sh): http://127.0.0.1:10000
YELLOWSTONE_ENDPOINT=http://127.0.0.1:10000
YELLOWSTONE_X_TOKEN=
# Cursor name; change it to run a second stream against the same database.
INGEST_STREAM=default
